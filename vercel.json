{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/health.js": {
      "maxDuration": 10
    }
  },
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/(?:server\\.js|package\\.json|package-lock\\.json|vercel\\.json|render\\.yaml|\\.gitignore|DEPLOYMENT\\.md|README\\.md|LICENSE)$",
      "status": 404
    },
    {
      "src": "^/\\.env(?:\\..*)?$",
      "status": 404
    },
    {
      "src": "^/api/.*\\.js$",
      "status": 404
    },
    {
      "src": "^/api/chat$",
      "dest": "/api/chat.js"
    },
    {
      "src": "^/api/health$",
      "dest": "/api/health.js"
    },
    {
      "src": "^/health$",
      "dest": "/api/health.js"
    },
    {
      "src": "^/$",
      "dest": "/ai.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
